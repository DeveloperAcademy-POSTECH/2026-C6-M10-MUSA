{
  "frames": [
    {
      "number": 1,
      "cutId": "OP_001",
      "pages": [
        {
          "speaker": "",
          "dialogue": "깊은 산중, 삼라만상 도술학교.\n백 년 만의 대제사가 머지 않았다."
        }
      ]
    },
    {
      "number": 2,
      "cutId": "OP_002",
      "pages": [
        {
          "speaker": "사부님",
          "dialogue": "이레 뒤에 돌아올 테니,\n수장고를 깨끗이 청소해 놓거라!"
        }
      ]
    },
    {
      "number": 3,
      "cutId": "OP_003",
      "pages": [
        {
          "speaker": "사부님",
          "dialogue": "특히 안쪽 선반에 있는 물건은\n절대로 건드리지 말거라."
        }
      ]
    },
    {
      "number": 4,
      "cutId": "OP_004",
      "pages": [
        {
          "speaker": "",
          "dialogue": ""
        }
      ]
    },
    {
      "number": 5,
      "cutId": "OP_005",
      "pages": [
        {
          "speaker": "불이",
          "dialogue": "어휴 걱정마세요~\n깨~끗하게 청소해 놓겠습니다~"
        }
      ]
    },
    {
      "number": 6,
      "cutId": "OP_006",
      "pages": [
        {
          "speaker": "",
          "dialogue": "사부님들은 구름에 올랐고,\n견습 도사들은 빗자루를 들었다."
        }
      ]
    },
    {
      "number": 7,
      "cutId": "OP_007",
      "pages": [
        {
          "speaker": "불이",
          "dialogue": "어후, 이 넓은 곳을 우리끼리 전부 다?!\n치워도 치워도 끝이 없잖아…"
        }
      ]
    },
    {
      "number": 8,
      "cutId": "OP_008",
      "pages": [
        {
          "speaker": "불이",
          "dialogue": "얘들아 우리 그냥\n도술로 한 번에 끝내버릴까~?"
        }
      ]
    },
    {
      "number": 9,
      "cutId": "OP_009",
      "pages": [
        {
          "speaker": "금옥",
          "dialogue": "뭐? 그런 주문 아직 안 배웠잖아!\n멋대로 쓰면 안 돼!"
        }
      ]
    },
    {
      "number": 10,
      "cutId": "OP_010",
      "pages": [
        {
          "speaker": "불이",
          "dialogue": "에이~ 뭘 어렵다고. 괜찮아 괜찮아~"
        }
      ]
    },
    {
      "number": 11,
      "cutId": "OP_011",
      "pages": [
        {
          "speaker": "불이",
          "dialogue": "자, 깨끗해져라!  청. 정. 무. 진."
        }
      ]
    },
    {
      "number": 12,
      "cutId": "OP_012",
      "pages": [
        {
          "speaker": "불이",
          "dialogue": "오오! 이것봐 어때?! 잘 되지?!\n역시 나만 믿으라니까!"
        }
      ]
    },
    {
      "number": 13,
      "cutId": "OP_013",
      "pages": [
        {
          "speaker": "불이",
          "dialogue": "엇... 어라..? 멈.. 멈춰라..! 멈춰!!!"
        }
      ]
    },
    {
      "number": 14,
      "cutId": "OP_014",
      "pages": [
        {
          "speaker": "",
          "dialogue": ""
        }
      ]
    },
    {
      "number": 15,
      "cutId": "OP_015",
      "pages": [
        {
          "speaker": "",
          "dialogue": ""
        }
      ]
    },
    {
      "number": 16,
      "cutId": "OP_016",
      "pages": [
        {
          "speaker": "",
          "dialogue": ""
        }
      ]
    },
    {
      "number": 17,
      "cutId": "OP_017",
      "pages": [
        {
          "speaker": "만복",
          "dialogue": "흐아아앙 ㅠㅠ\n우리 이제 어떡해애ㅠㅠㅠ"
        }
      ]
    },
    {
      "number": 18,
      "cutId": "OP_018",
      "pages": [
        {
          "speaker": "솔이",
          "dialogue": "이거... 요괴들이 봉인 되어있던 \n호리병인가본데... 다 사라졌어..."
        }
      ]
    },
    {
      "number": 19,
      "cutId": "OP_019",
      "pages": [
        {
          "speaker": "불이",
          "dialogue": "그냥.. 풀로 붙이면 안될까..?"
        }
      ]
    },
    {
      "number": 20,
      "cutId": "OP_020",
      "pages": [
        {
          "speaker": "금옥",
          "dialogue": "되겠냐."
        }
      ]
    },
    {
      "number": 21,
      "cutId": "OP_021",
      "pages": [
        {
          "speaker": "묵이",
          "dialogue": "얘들아 잠깐! 여기 좀 봐!"
        }
      ]
    },
    {
      "number": 22,
      "cutId": "OP_022",
      "pages": [
        {
          "speaker": "묵이",
          "dialogue": "임시 봉인박?!\n이 사태를 해결할 방법이 있겠어!"
        }
      ]
    },
    {
      "number": 23,
      "cutId": "OP_023",
      "pages": [
        {
          "speaker": "",
          "dialogue": ""
        }
      ]
    },
    {
      "number": 24,
      "cutId": "OP_024",
      "pages": [
        {
          "speaker": "만복",
          "dialogue": "이 구슬들은 뭘까?\n검은 것도 있고, 하얀 것도 있네?"
        }
      ]
    },
    {
      "number": 25,
      "cutId": "OP_025",
      "pages": [
        {
          "speaker": "솔이",
          "dialogue": "그래! 음 양 구슬 두개를 합치면 ..."
        }
      ]
    },
    {
      "number": 26,
      "cutId": "OP_026",
      "pages": [
        {
          "speaker": "솔이",
          "dialogue": "오색의 오행 구슬이 되는거야!"
        }
      ]
    },
    {
      "number": 27,
      "cutId": "OP_027",
      "pages": [
        {
          "speaker": "솔이",
          "dialogue": "이 구슬들로 봉인박 전체에\n오행의 기운을 고르게 입히면 돼!"
        }
      ]
    },
    {
      "number": 28,
      "cutId": "OP_028",
      "pages": [
        {
          "speaker": "불이",
          "dialogue": "좋아! 어서 요괴 잡으러가자!\n사부님 돌아오시기 전에..."
        }
      ]
    }
  ]
