.clay-app {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: row;
    background-color: rgb(19, 24, 29);
    color: rgb(235, 239, 241);
    font-size: 16px;
}
.clay-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 100px;
    min-height: 150px;
    overflow: hidden;
}
.clay-preview-image {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}
.clay-panel {
    width: 316px;
    flex-shrink: 0;
    padding-left: 18px;
    padding-right: 14px;
    padding-top: 18px;
    padding-bottom: 16px;
    background-color: rgb(31, 39, 46);
    border-left-width: 1px;
    border-left-color: rgb(55, 66, 74);
}
.clay-panel-content { flex-grow: 1; flex-shrink: 0; padding-right: 8px; }
.clay-panel-content > * { flex-shrink: 0; }
.clay-heading { font-size: 23px; -unity-font-style: bold; margin-bottom: 5px; }
.clay-subtitle { color: rgb(155, 175, 185); font-size: 13px; white-space: normal; margin-bottom: 14px; }
.clay-field-heading { flex-direction: row; justify-content: space-between; margin-bottom: 4px; }
.clay-field-label { font-size: 13px; -unity-font-style: bold; color: rgb(184, 202, 211); }
.clay-number { font-size: 17px; -unity-font-style: bold; color: rgb(255, 232, 189); }
.clay-slider { height: 32px; margin-bottom: 12px; flex-shrink: 0; }
.clay-slider .unity-base-field__label { display: none; }
.clay-slider .unity-base-field__input { flex-grow: 1; min-width: 30px; }
.clay-slider .unity-base-slider__input { flex-grow: 1; min-width: 30px; height: 30px; }
.clay-slider .unity-base-slider__drag-container { flex-grow: 1; height: 30px; }
.clay-slider .unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 13px;
    height: 4px;
    background-color: rgb(89, 106, 115);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}
.clay-slider .unity-base-slider__dragger {
    position: absolute;
    width: 18px;
    height: 24px;
    top: 3px;
    background-color: rgb(245, 222, 178);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-width: 1px;
    border-color: rgb(255, 244, 220);
}
.clay-slider .unity-base-slider__dragger-border { display: none; }
.clay-section-label { font-size: 12px; color: rgb(155, 175, 185); margin-bottom: 9px; }
.clay-button-row { flex-direction: row; margin-bottom: 7px; }
.clay-button {
    flex-grow: 1;
    flex-basis: 0;
    height: 36px;
    margin-right: 5px;
    padding-left: 5px;
    padding-right: 5px;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgb(235, 240, 242);
    background-color: rgb(53, 69, 79);
    border-width: 1px;
    border-color: rgb(79, 97, 107);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}
.clay-button:hover { background-color: rgb(67, 88, 101); }
.clay-button:active { background-color: rgb(37, 53, 64); }
.clay-button:focus { border-color: rgb(245, 222, 178); }
.clay-preset {
    flex-grow: 0;
    flex-basis: auto;
    flex-shrink: 0;
    min-height: 36px;
    height: auto;
    padding-top: 7px;
    padding-bottom: 7px;
    margin-right: 0;
    margin-bottom: 5px;
    white-space: normal;
}
.clay-preset-active { background-color: rgb(86, 78, 60); border-color: rgb(245, 222, 178); }
.clay-extras:disabled { opacity: 0.45; }
.clay-primary { height: 38px; margin-top: 12px; flex-grow: 0; flex-basis: auto; flex-shrink: 0; }
.clay-quit { margin-top: 8px; flex-grow: 0; flex-basis: auto; flex-shrink: 0; }
.clay-spacer { flex-grow: 1; min-height: 18px; }
.clay-status { font-size: 12px; color: rgb(155, 175, 185); white-space: normal; }
.clay-error { color: rgb(255, 158, 141); }

.clay-palette { margin-bottom: 14px; flex-shrink: 0; }
.clay-palette .unity-foldout__content { margin-left: 0; }
.clay-palette-row { flex-direction: row; align-items: center; margin-bottom: 10px; flex-shrink: 0; }
.clay-palette-swatch { width: 24px; height: 24px; flex-shrink: 0; margin-right: 6px; }
.clay-rgb-field { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 3px; }
.clay-rgb-field .unity-base-field__label { min-width: 10px; width: 10px; margin-right: 2px; font-size: 11px; }
.clay-rgb-field .unity-base-field__input { min-width: 0; color: rgb(235, 239, 241); background-color: rgb(53, 69, 79); padding-left: 3px; padding-right: 2px; font-size: 13px; }

.clay-hex-field { width: 116px; flex-shrink: 0; margin-right: 3px; }
.clay-hex-field .unity-base-field__label { min-width: 24px; width: 24px; margin-right: 3px; font-size: 11px; }
.clay-hex-field .unity-base-field__input { min-width: 0; color: rgb(235, 239, 241); background-color: rgb(53, 69, 79); padding-left: 4px; padding-right: 3px; font-size: 13px; }
.clay-hex-invalid .unity-base-field__input { border-width: 1px; border-color: rgb(237, 104, 92); }


.clay-image-files { margin-top: 10px; margin-bottom: 16px; flex-shrink: 0; }
.clay-image-files .unity-foldout__content { margin-left: 0; }
.clay-image-files .clay-section-label { margin-top: 12px; }
.clay-image-files .clay-button-row { margin-top: 6px; }
.clay-image-files .clay-button-row .clay-button { white-space: normal; height: 44px; font-size: 11px; }
.clay-file-button { flex-grow: 0; flex-basis: auto; flex-shrink: 0; margin-top: 5px; margin-bottom: 5px; margin-right: 0; }
.clay-file-name { font-size: 12px; color: rgb(201, 215, 222); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 4px; margin-bottom: 5px; }
.clay-file-thumbnail { width: 100%; height: 70px; flex-shrink: 0; margin-top: 3px; margin-bottom: 8px; background-color: rgb(19, 24, 29); }
.clay-file-toggle { font-size: 12px; margin-top: 7px; margin-bottom: 10px; white-space: normal; }
.clay-file-toggle .unity-toggle__input {
    flex-direction: row;
    align-items: center;
}
.clay-file-toggle .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 7px;
    border-width: 1px;
    border-color: rgb(184, 202, 211);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: rgb(19, 24, 29);
}
.clay-file-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(245, 222, 178);
    border-color: rgb(255, 244, 220);
}
#textureControls:disabled { opacity: .45; }
